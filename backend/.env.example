PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Set this when the API runs behind a trusted reverse proxy.
# TRUST_PROXY=1

# SRV connections use public resolvers by default. Use "system" for a
# private/corporate MongoDB hostname, or provide your own comma-separated list.
# DNS_SERVERS=system
