PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=https://actual-app-name.vercel.appNODE_ENV=development
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
VITE_API_URL=https://actual-api-name.onrender.com
# Set this when the API runs behind a trusted reverse proxy.
# TRUST_PROXY=1

# Optional comma-separated DNS resolvers for MongoDB SRV connections.
# By default, the platform's system resolver is used.
# DNS_SERVERS=8.8.8.8,1.1.1.1
